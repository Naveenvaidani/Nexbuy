# Auto detect text files and normalize line endings to LF
* text=auto

# PowerShell
*.ps1 text eol=lf
*.ps1x text eol=lf
*.psd1 text eol=lf
*.psm1 text eol=lf

# Batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# JavaScript/TypeScript/Python
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Docker and config files
Dockerfile text eol=lf
docker-compose.yml text eol=lf
docker-compose.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
