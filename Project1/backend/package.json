{
  "name": "nexbuy-backend",
  "version": "1.0.0",
  "description": "NexBuy Backend API - The Future of Shopping",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=tests/integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "seed": "node scripts/seedProducts.js",
    "verify:images": "node scripts/verifyImages.js",
    "seed:all": "node scripts/seedAll.js"
  },
  "keywords": [
    "ecommerce",
    "shopping",
    "voice-assistant",
    "visual-search",
    "comparison"
  ],
  "author": "NexBuy Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.0",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.0",
    "axios": "^1.6.2",
    "socket.io": "^4.6.0",
    "stripe": "^14.7.0",
    "ioredis": "^5.3.2",
    "node-cache": "^5.1.2",
    "crypto-js": "^4.2.0",
    "jimp": "^0.22.10",
    "image-hash": "^5.3.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "express-validator": "^7.0.1",
    "node-fetch": "^2.7.0",
    "@tensorflow/tfjs-node": "^4.20.0",
    "@tensorflow-models/mobilenet": "^2.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.54.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "@types/jest": "^29.5.10"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
