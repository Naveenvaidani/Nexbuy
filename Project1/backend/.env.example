# ============================================
# NexBuy Environment Configuration
# ============================================

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://127.0.0.1:3000

# ============================================
# DATABASE
# ============================================
MONGODB_URI=mongodb://localhost:27017/nexbuy

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# ============================================
# AMAZON PRODUCT ADVERTISING API 5.0
# ============================================
# Get credentials from: https://affiliate-program.amazon.com/
# Documentation: https://webservices.amazon.com/paapi5/documentation/

AMAZON_ACCESS_KEY=your-amazon-access-key-here
AMAZON_SECRET_KEY=your-amazon-secret-key-here
AMAZON_ASSOC_TAG=your-amazon-associate-tag-here
AMAZON_REGION=us-east-1
AMAZON_MARKETPLACE=www.amazon.com

# Available regions:
# us-east-1 (www.amazon.com - United States)
# eu-west-1 (www.amazon.co.uk - United Kingdom)
# us-west-2 (www.amazon.ca - Canada)
# ap-northeast-1 (www.amazon.co.jp - Japan)
# eu-central-1 (www.amazon.de - Germany)

# ============================================
# FLIPKART AFFILIATE API
# ============================================
# Get credentials from: https://affiliate.flipkart.com/
# Documentation: https://affiliate.flipkart.com/api-docs/

FLIPKART_AFFILIATE_ID=your-flipkart-affiliate-id
FLIPKART_AFFILIATE_TOKEN=your-flipkart-affiliate-token
FLIPKART_TRACKING_ID=your-flipkart-tracking-id

# ============================================
# REDIS CACHE (Optional - for production)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=3600
# Cache TTL in seconds (3600 = 1 hour)

# ============================================
# PAYMENT GATEWAY
# ============================================
# Razorpay (for Indian market)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Stripe (for international)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE=5242880
# Maximum file size in bytes (5MB = 5242880)
UPLOAD_PATH=./uploads

# ============================================
# EMAIL CONFIGURATION (for notifications)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
FROM_EMAIL=noreply@nexbuy.com
FROM_NAME=NexBuy

# ============================================
# SMS NOTIFICATIONS (Optional)
# ============================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# TENSORFLOW.JS (Image Recognition)
# ============================================
TF_MODEL_PATH=./models/mobilenet
TF_SIZE_ANALYZER_PATH=./models/size-analyzer

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds
RATE_LIMIT_MAX=100
# Max requests per window

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
# Options: error, warn, info, debug
LOG_FILE=./logs/app.log

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000

# ============================================
# SESSION
# ============================================
SESSION_SECRET=your-session-secret-change-this
SESSION_TIMEOUT=3600000
# Session timeout in milliseconds (1 hour)

# ============================================
# NOTIFICATIONS
# ============================================
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_VOICE_ASSISTANT=true
ENABLE_VISUAL_SEARCH=true
ENABLE_WALLET=true
ENABLE_REFERRAL_PROGRAM=true
ENABLE_MULTI_VENDOR=true

# ============================================
# EXTERNAL APIS (Optional)
# ============================================
# Snapdeal API (if available)
SNAPDEAL_API_KEY=your-snapdeal-api-key
SNAPDEAL_AFFILIATE_ID=your-snapdeal-affiliate-id

# TataCliq API (if available)
TATACLIQ_API_KEY=your-tatacliq-api-key
TATACLIQ_AFFILIATE_ID=your-tatacliq-affiliate-id

# ============================================
# ANALYTICS (Optional)
# ============================================
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=your-mixpanel-token

# ============================================
# SENTRY ERROR TRACKING (Optional)
# ============================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================
# DEPLOYMENT
# ============================================
BASE_URL=http://localhost:5000
HTTPS_ENABLED=false
# Set to true in production

# ============================================
# NOTES
# ============================================
# 1. Never commit this file with real credentials
# 2. Copy this to .env and fill in your actual values
# 3. Keep .env in .gitignore
# 4. Use strong, unique values for all secrets
# 5. Rotate credentials regularly in production
