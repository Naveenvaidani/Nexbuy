# OpenAI configuration for chatbot
# Copy to `.env` and set your real key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_API_BASE=https://api.openai.com/v1

# Chatbot behavior
CHATBOT_ENABLE_GUEST=true
CHATBOT_SYSTEM_PROMPT=NexBuy shopping assistant. Be helpful and concise.
# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=https://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/nexbuy

# JWT Secret (generate a secure random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Data Provider Mode (mock or live)
DATA_PROVIDER_MODE=mock

# Amazon Product Advertising API
# Sign up at: https://affiliate-program.amazon.com/assoc_credentials/home
AMAZON_ACCESS_KEY=your-amazon-access-key
AMAZON_SECRET_KEY=your-amazon-secret-key
AMAZON_ASSOC_TAG=your-amazon-associate-tag
AMAZON_REGION=us-east-1

# Flipkart Affiliate API
# Sign up at: https://affiliate.flipkart.com/
FLIPKART_AFFILIATE_ID=your-flipkart-affiliate-id
FLIPKART_AFFILIATE_TOKEN=your-flipkart-affiliate-token

# Stripe Payment (Test Mode)
# Get keys at: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Razorpay (Alternative Payment Gateway - Sandbox)
# RAZORPAY_KEY_ID=rzp_test_your-key-id
# RAZORPAY_KEY_SECRET=your-key-secret

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379

# Cache Settings
CACHE_TTL=3600
PRODUCT_CACHE_TTL=1800

# Voice & Image Processing
MAX_UPLOAD_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
VOICE_RECORDING_MAX_DURATION=60

# Referral System
REFERRAL_REWARD_COINS=100
REFEREE_REWARD_COINS=50

# Wallet & Coins
INITIAL_WALLET_BALANCE=0
INITIAL_COINS_BALANCE=50

# Email (Optional - for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=https://localhost:3000

# Socket.io
SOCKET_IO_CORS_ORIGIN=https://localhost:3000
