# Auto detect text files and normalize line endings to LF
* text=auto

# PowerShell
*.ps1 text eol=lf
*.ps1x text eol=lf
*.psd1 text eol=lf
*.psm1 text eol=lf

# Batch files
*.bat text eol=crlf
*.cmd text eol=crlf
*.exe binary

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# JavaScript/TypeScript
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf

# Python
*.py text eol=lf
*.pyw text eol=lf

# Docker
Dockerfile text eol=lf
docker-compose.yml text eol=lf
docker-compose.yaml text eol=lf

# Git
.gitattributes text eol=lf
.gitignore text eol=lf

# Markdown
*.md text eol=lf
*.markdown text eol=lf

# YAML
*.yml text eol=lf
*.yaml text eol=lf

# CSS
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf

# HTML
*.html text eol=lf
*.htm text eol=lf
*.svg text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.webp binary

# Archives
*.zip binary
*.tar binary
*.tar.gz binary
*.rar binary
